# InsForge
NEXT_PUBLIC_INSFORGE_URL=https://your-appkey.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-anon-key

# Server-only secret used to encrypt saved external data-source credentials.
# Use at least 32 random characters and never expose it as NEXT_PUBLIC_*.
DATA_SOURCE_CREDENTIALS_KEY=replace-with-32-plus-random-characters

# AI Provider (optional - mock provider used when not set)
AI_PROVIDER_API_KEY=
AI_PROVIDER_ENDPOINT=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4
